DEPLOY_HOST=서버_IP
DEPLOY_SSH_PORT=9922
DEPLOY_USER=계정명
DEPLOY_PASS=비밀번호
DEPLOY_REMOTE_PATH=/home/계정명/AgentPortal
DEPLOY_APP_PORT=9000
# LLM — Anthropic 키가 있으면 우선 사용하고, 없거나 실패하면 Gemini로 넘어간다.
# 둘 중 하나는 있어야 오케스트레이터가 동작한다.
ANTHROPIC_API_KEY=sk-ant-...
# Gemini 키는 쉼표로 여러 개 (고시·프니·에리와 같은 규약). 라운드로빈으로 돌려 쓴다.
GEMINI_API_KEYS=키1,키2,키3
GEMINI_MODEL=gemini-2.5-flash
